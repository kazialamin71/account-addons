<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_report_financial_form_initial" model="ir.ui.view">
        <field name="name">accounting.report.form.initial.balance</field>
        <field name="model">accounting.report</field>
        <field name="inherit_id" ref="leih_account_v8.view_account_report_financial_form"/>
        <field name="arch" type="xml">
            <field name="debit_credit" position="after">
                <field name="initial_balance"/>
            </field>
        </field>
    </record>

    <record id="view_report_financial_line_list_initial" model="ir.ui.view">
        <field name="name">leih.report.balance.line.financial.list.initial.balance</field>
        <field name="model">leih.report.balance.line</field>
        <field name="inherit_id" ref="leih_account_v8.view_report_financial_line_list"/>
        <field name="arch" type="xml">
            <field name="balance" position="before">
                <field name="initial_balance" string="Initial Balance" sum="Initial"/>
            </field>
        </field>
    </record>

</odoo>

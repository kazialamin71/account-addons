<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_generate_asset_entries" model="ir.cron">
            <field name="name">Assets: Post Due Depreciation</field>
            <field name="model_id" ref="model_account_asset_asset"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_entries()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>

        <record id="sequence_account_voucher_receipt" model="ir.sequence">
            <field name="name">Customer Receipt Voucher</field>
            <field name="code">account.voucher.receipt</field>
            <field name="prefix">RV/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="sequence_account_voucher_payment" model="ir.sequence">
            <field name="name">Supplier Payment Voucher</field>
            <field name="code">account.voucher.payment</field>
            <field name="prefix">PV/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>

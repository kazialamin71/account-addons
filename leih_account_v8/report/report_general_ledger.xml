<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Shared movement table: General Ledger, Partner Ledger, Journal, books.
         All four are the same columns over a different grouping. -->
    <template id="report_ledger_body">
        <table class="table table-sm o_main_table" style="font-size: 10px;">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Entry</th>
                    <th>Account</th>
                    <th>Partner</th>
                    <th>Description</th>
                    <th class="text-end">Debit</th>
                    <th class="text-end">Credit</th>
                    <th class="text-end">Balance</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="report['rows']" t-as="row"
                    t-att-class="'table-active' if row.get('is_group') else ''">
                    <td><span t-esc="row.get('date')"/></td>
                    <td><span t-esc="row.get('move_name') or ''"/></td>
                    <td><span t-esc="row.get('account_name') or ''"/></td>
                    <td><span t-esc="row.get('partner_name') or ''"/></td>
                    <td>
                        <t t-set="label" t-value="row.get('label')"/>
                        <t t-call="leih_account_v8.report_indent_label"/>
                    </td>
                    <td class="text-end">
                        <span t-esc="row.get('debit') or 0.0"
                              t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                    </td>
                    <td class="text-end">
                        <span t-esc="row.get('credit') or 0.0"
                              t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                    </td>
                    <td class="text-end">
                        <span t-esc="row.get('cumulative') or row.get('balance') or 0.0"
                              t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                    </td>
                </tr>
            </tbody>
        </table>
    </template>

    <template id="report_general_ledger">
        <t t-call="web.html_container">
            <t t-foreach="reports" t-as="report">
                <t t-set="header" t-value="report['header']"/>
                <t t-call="web.internal_layout">
                    <div class="page">
                        <h2 class="text-center">General Ledger</h2>
                        <t t-call="leih_account_v8.report_filters_header"/>
                        <t t-call="leih_account_v8.report_ledger_body"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>

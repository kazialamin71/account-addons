<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The filter block every classic report prints under its title. -->
    <template id="report_filters_header">
        <div class="row mt8 mb8">
            <div class="col-6">
                <table class="table table-sm table-borderless" style="font-size: 11px;">
                    <tr>
                        <td><strong>Company</strong></td>
                        <td><span t-esc="header['company']"/></td>
                    </tr>
                    <tr>
                        <td><strong>Fiscal Year</strong></td>
                        <td><span t-esc="header['fiscalyear'] or 'All'"/></td>
                    </tr>
                </table>
            </div>
            <div class="col-6">
                <table class="table table-sm table-borderless" style="font-size: 11px;">
                    <tr>
                        <td><strong>Period</strong></td>
                        <td><span t-esc="header['filter_label']"/></td>
                    </tr>
                    <tr>
                        <td><strong>Journals</strong></td>
                        <td><span t-esc="header['journals']"/></td>
                    </tr>
                    <tr>
                        <td><strong>Entries</strong></td>
                        <td><span t-esc="header['target_move']"/></td>
                    </tr>
                </table>
            </div>
        </div>
    </template>

    <!-- Indentation helper: renders a label pushed right by its level. -->
    <template id="report_indent_label">
        <span t-att-style="'padding-left: %spx;' % (12 * (row.get('level') or 0))">
            <t t-if="row.get('is_group')"><strong t-esc="label"/></t>
            <t t-else=""><span t-esc="label"/></t>
        </span>
    </template>

</odoo>

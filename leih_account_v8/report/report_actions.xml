<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The movement reports are wide; give them landscape A4. -->
    <record id="paperformat_financial_landscape" model="report.paperformat">
        <field name="name">A4 Landscape (Financial Reports)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">28</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">20</field>
        <field name="dpi">90</field>
    </record>

    <!-- Wizard-driven financial reports. Printed from the wizard's Print button;
         no binding, since they make no sense from a list of wizard records. -->

    <record id="action_report_general_ledger" model="ir.actions.report">
        <field name="name">General Ledger</field>
        <field name="model">account.report.general.ledger</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">leih_account_v8.report_general_ledger</field>
        <field name="report_file">leih_account_v8.report_general_ledger</field>
        <field name="paperformat_id" ref="paperformat_financial_landscape"/>
    </record>

    <record id="action_report_trial_balance" model="ir.actions.report">
        <field name="name">Trial Balance</field>
        <field name="model">account.balance.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">leih_account_v8.report_trial_balance</field>
        <field name="report_file">leih_account_v8.report_trial_balance</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <record id="action_report_partner_ledger" model="ir.actions.report">
        <field name="name">Partner Ledger</field>
        <field name="model">account.report.partnerledger</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">leih_account_v8.report_partner_ledger</field>
        <field name="report_file">leih_account_v8.report_partner_ledger</field>
        <field name="paperformat_id" ref="paperformat_financial_landscape"/>
    </record>

    <record id="action_report_aged_partner" model="ir.actions.report">
        <field name="name">Aged Partner Balance</field>
        <field name="model">account.aged.trial.balance</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">leih_account_v8.report_aged_partner</field>
        <field name="report_file">leih_account_v8.report_aged_partner</field>
        <field name="paperformat_id" ref="paperformat_financial_landscape"/>
    </record>

    <record id="action_report_journal" model="ir.actions.report">
        <field name="name">Journal Report</field>
        <field name="model">account.report.journal</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">leih_account_v8.report_journal</field>
        <field name="report_file">leih_account_v8.report_journal</field>
        <field name="paperformat_id" ref="paperformat_financial_landscape"/>
    </record>

    <record id="action_report_financial" model="ir.actions.report">
        <field name="name">Financial Report</field>
        <field name="model">accounting.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">leih_account_v8.report_financial</field>
        <field name="report_file">leih_account_v8.report_financial</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <record id="action_report_tax" model="ir.actions.report">
        <field name="name">Taxes Report</field>
        <field name="model">account.tax.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">leih_account_v8.report_tax</field>
        <field name="report_file">leih_account_v8.report_tax</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <record id="action_report_book" model="ir.actions.report">
        <field name="name">Cash / Bank / Day Book</field>
        <field name="model">account.book.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">leih_account_v8.report_book</field>
        <field name="report_file">leih_account_v8.report_book</field>
        <field name="paperformat_id" ref="paperformat_financial_landscape"/>
    </record>

    <!-- Document reports, printable straight from the record. -->

    <record id="action_report_voucher" model="ir.actions.report">
        <field name="name">Voucher</field>
        <field name="model">account.voucher</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">leih_account_v8.report_voucher</field>
        <field name="report_file">leih_account_v8.report_voucher</field>
        <field name="print_report_name">'Voucher - %s' % (object.number)</field>
        <field name="binding_model_id" ref="model_account_voucher"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_asset" model="ir.actions.report">
        <field name="name">Depreciation Board</field>
        <field name="model">account.asset.asset</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">leih_account_v8.report_asset</field>
        <field name="report_file">leih_account_v8.report_asset</field>
        <field name="print_report_name">'Asset - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_account_asset_asset"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_budget" model="ir.actions.report">
        <field name="name">Budget</field>
        <field name="model">crossovered.budget</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">leih_account_v8.report_budget</field>
        <field name="report_file">leih_account_v8.report_budget</field>
        <field name="print_report_name">'Budget - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_crossovered_budget"/>
        <field name="binding_type">report</field>
    </record>

</odoo>

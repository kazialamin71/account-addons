<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_asset_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2 class="text-center">Depreciation Board</h2>
                <div class="row mt32 mb32">
                    <div class="col-6">
                        <strong>Asset:</strong> <span t-field="doc.name"/><br/>
                        <strong>Reference:</strong> <span t-field="doc.code"/><br/>
                        <strong>Category:</strong> <span t-field="doc.category_id"/>
                    </div>
                    <div class="col-6">
                        <strong>Asset Date:</strong> <span t-field="doc.date"/><br/>
                        <strong>Gross Value:</strong> <span t-field="doc.value"/><br/>
                        <strong>Salvage Value:</strong> <span t-field="doc.salvage_value"/><br/>
                        <strong>Residual:</strong> <span t-field="doc.value_residual"/>
                    </div>
                </div>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Reference</th>
                            <th>Depreciation Date</th>
                            <th class="text-end">Depreciation</th>
                            <th class="text-end">Cumulative</th>
                            <th class="text-end">Residual</th>
                            <th>Entry</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.depreciation_line_ids" t-as="line">
                            <td><span t-field="line.sequence"/></td>
                            <td><span t-field="line.name"/></td>
                            <td><span t-field="line.depreciation_date"/></td>
                            <td class="text-end"><span t-field="line.amount"/></td>
                            <td class="text-end"><span t-field="line.depreciated_value"/></td>
                            <td class="text-end"><span t-field="line.remaining_value"/></td>
                            <td><span t-field="line.move_id"/></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="report_asset">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="leih_account_v8.report_asset_document"/>
            </t>
        </t>
    </template>

</odoo>

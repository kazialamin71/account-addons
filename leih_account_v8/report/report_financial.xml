<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_financial">
        <t t-call="web.html_container">
            <t t-foreach="reports" t-as="report">
                <t t-set="header" t-value="report['header']"/>
                <t t-set="wizard" t-value="report['wizard']"/>
                <t t-call="web.internal_layout">
                    <div class="page">
                        <h2 class="text-center">
                            <span t-esc="wizard.account_report_id.name"/>
                        </h2>
                        <t t-call="leih_account_v8.report_filters_header"/>
                        <table class="table table-sm o_main_table" style="font-size: 10px;">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th t-if="wizard.debit_credit" class="text-end">Debit</th>
                                    <th t-if="wizard.debit_credit" class="text-end">Credit</th>
                                    <th class="text-end">Amount</th>
                                    <th t-if="wizard.enable_filter" class="text-end">
                                        <span t-esc="wizard.label_filter"/>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="report['rows']" t-as="row"
                                    t-att-class="'table-active' if row.get('is_group') else ''">
                                    <td>
                                        <t t-set="label"
                                           t-value="(row.get('code') and row['code'] + ' ' or '') + (row.get('name') or '')"/>
                                        <t t-call="leih_account_v8.report_indent_label"/>
                                    </td>
                                    <td t-if="wizard.debit_credit" class="text-end">
                                        <span t-esc="row.get('debit') or 0.0"
                                              t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                    </td>
                                    <td t-if="wizard.debit_credit" class="text-end">
                                        <span t-esc="row.get('credit') or 0.0"
                                              t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="row.get('balance') or 0.0"
                                              t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                    </td>
                                    <td t-if="wizard.enable_filter" class="text-end">
                                        <span t-esc="row.get('balance_cmp') or 0.0"
                                              t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_tax">
        <t t-call="web.html_container">
            <t t-foreach="reports" t-as="report">
                <t t-set="header" t-value="report['header']"/>
                <t t-call="web.internal_layout">
                    <div class="page">
                        <h2 class="text-center">Taxes Report</h2>
                        <t t-call="leih_account_v8.report_filters_header"/>
                        <table class="table table-sm o_main_table" style="font-size: 10px;">
                            <thead>
                                <tr>
                                    <th>Case Code</th>
                                    <th>Tax Case</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="report['rows']" t-as="row"
                                    t-att-class="'table-active' if row.get('is_group') else ''">
                                    <td><span t-esc="row.get('code')"/></td>
                                    <td>
                                        <t t-set="label" t-value="row.get('name')"/>
                                        <t t-call="leih_account_v8.report_indent_label"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="row.get('amount') or 0.0"
                                              t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>

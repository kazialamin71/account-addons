<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_period_close_form" model="ir.ui.view">
        <field name="name">account.period.close.form</field>
        <field name="model">account.period.close</field>
        <field name="arch" type="xml">
            <form string="Close Periods">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        Once closed, no journal entry can be posted into these periods.
                        A manager can re-open a period from the Periods list.
                    </div>
                    <group>
                        <field name="period_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="sure"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_close" type="object" string="Close Periods"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_period_close" model="ir.actions.act_window">
        <field name="name">Close a Period</field>
        <field name="res_model">account.period.close</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>

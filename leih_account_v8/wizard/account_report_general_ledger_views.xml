<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_report_general_ledger_form" model="ir.ui.view">
        <field name="name">account.report.general.ledger.form</field>
        <field name="model">account.report.general.ledger</field>
        <field name="arch" type="xml">
            <form string="General Ledger">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="fiscalyear_id"/>
                            <field name="target_move" widget="radio"/>
                        </group>
                        <group>
                            <field name="filter" widget="radio"/>
                            <field name="date_from" invisible="filter != 'filter_date'"
                                   required="filter == 'filter_date'"/>
                            <field name="date_to" invisible="filter != 'filter_date'"
                                   required="filter == 'filter_date'"/>
                            <field name="period_from" invisible="filter != 'filter_period'"
                                   required="filter == 'filter_period'"
                                   domain="[('company_id', '=', company_id)]"/>
                            <field name="period_to" invisible="filter != 'filter_period'"
                                   required="filter == 'filter_period'"
                                   domain="[('company_id', '=', company_id)]"/>
                        </group>
                    </group>
                    <group string="Journals">
                        <field name="journal_ids" nolabel="1" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                    <group string="Options">
                        <field name="initial_balance"/>
                        <field name="sortby"/>
                        <field name="display_account"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_view" type="object" string="View"
                            class="btn-primary" data-hotkey="q"/>
                    <button name="action_print" type="object" string="Print PDF"
                            class="btn-secondary" data-hotkey="w"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_report_general_ledger" model="ir.actions.act_window">
        <field name="name">General Ledger</field>
        <field name="res_model">account.report.general.ledger</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_account_report_general_ledger_form"/>
        <field name="target">new</field>
    </record>

</odoo>

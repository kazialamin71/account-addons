<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_fiscalyear_list" model="ir.ui.view">
        <field name="name">account.fiscalyear.list</field>
        <field name="model">account.fiscalyear</field>
        <field name="arch" type="xml">
            <list string="Fiscal Years" decoration-muted="state == 'done'">
                <field name="name"/>
                <field name="code"/>
                <field name="date_start"/>
                <field name="date_stop"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'draft'"
                       decoration-muted="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_account_fiscalyear_form" model="ir.ui.view">
        <field name="name">account.fiscalyear.form</field>
        <field name="model">account.fiscalyear</field>
        <field name="arch" type="xml">
            <form string="Fiscal Year">
                <header>
                    <button name="create_period" type="object" string="Create Monthly Periods"
                            class="btn-primary" invisible="period_ids or state == 'done'"/>
                    <button name="create_period3" type="object" string="Create Quarterly Periods"
                            invisible="period_ids or state == 'done'"/>
                    <button name="action_reopen" type="object" string="Re-open"
                            invisible="state != 'done'"
                            groups="account.group_account_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Fiscal Year 2026"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. FY26"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_stop"/>
                            <field name="end_journal_period_id" invisible="not end_journal_period_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Periods" name="periods">
                            <field name="period_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="date_start"/>
                                    <field name="date_stop"/>
                                    <field name="special"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_fiscalyear_search" model="ir.ui.view">
        <field name="name">account.fiscalyear.search</field>
        <field name="model">account.fiscalyear</field>
        <field name="arch" type="xml">
            <search string="Fiscal Years">
                <field name="name"/>
                <field name="code"/>
                <filter name="open" string="Open" domain="[('state', '=', 'draft')]"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'done')]"/>
            </search>
        </field>
    </record>

    <record id="action_account_fiscalyear" model="ir.actions.act_window">
        <field name="name">Fiscal Years</field>
        <field name="res_model">account.fiscalyear</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_account_fiscalyear_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your first fiscal year</p>
            <p>
                A fiscal year owns the accounting periods you post into. Create the
                year, then press "Create Monthly Periods" to generate its periods
                and the special opening period.
            </p>
        </field>
    </record>

</odoo>

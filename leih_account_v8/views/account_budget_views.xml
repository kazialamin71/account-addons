<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= Budgetary positions ================= -->
    <record id="view_account_budget_post_list" model="ir.ui.view">
        <field name="name">account.budget.post.list</field>
        <field name="model">account.budget.post</field>
        <field name="arch" type="xml">
            <list string="Budgetary Positions">
                <field name="code"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_account_budget_post_form" model="ir.ui.view">
        <field name="name">account.budget.post.form</field>
        <field name="model">account.budget.post</field>
        <field name="arch" type="xml">
            <form string="Budgetary Position">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Medical Consumables"/></h1>
                    </div>
                    <group>
                        <field name="code"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <separator string="Accounts"/>
                    <field name="account_ids">
                        <list>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="account_type"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_budget_post" model="ir.actions.act_window">
        <field name="name">Budgetary Positions</field>
        <field name="res_model">account.budget.post</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a budgetary position</p>
            <p>
                A budgetary position groups the general accounts a budget line is
                measured against, so "Medical Consumables" can cover a dozen
                accounts at once.
            </p>
        </field>
    </record>

    <!-- ================= Budgets ================= -->
    <record id="view_crossovered_budget_list" model="ir.ui.view">
        <field name="name">crossovered.budget.list</field>
        <field name="model">crossovered.budget</field>
        <field name="arch" type="xml">
            <list string="Budgets" decoration-info="state == 'draft'"
                  decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="creating_user_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'validate'"
                       decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_crossovered_budget_form" model="ir.ui.view">
        <field name="name">crossovered.budget.form</field>
        <field name="model">crossovered.budget</field>
        <field name="arch" type="xml">
            <form string="Budget">
                <header>
                    <button name="action_budget_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_budget_validate" type="object" string="Validate"
                            class="btn-primary" invisible="state != 'confirm'"/>
                    <button name="action_budget_done" type="object" string="Done"
                            invisible="state != 'validate'"/>
                    <button name="action_budget_cancel" type="object" string="Cancel"
                            invisible="state in ('draft', 'cancel', 'done')"/>
                    <button name="action_budget_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('cancel', 'done')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirm,validate,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Operating Budget 2026"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="creating_user_id"/>
                            <field name="validating_user_id" invisible="not validating_user_id"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Budget Lines" name="lines">
                            <field name="crossovered_budget_line"
                                   context="{'default_date_from': date_from,
                                             'default_date_to': date_to}">
                                <list editable="bottom" decoration-danger="percentage &gt; 1.0">
                                    <field name="general_budget_id"/>
                                    <field name="analytic_account_id"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="planned_amount" sum="Planned"/>
                                    <field name="practical_amount" sum="Practical"/>
                                    <field name="theoritical_amount" sum="Theoretical"/>
                                    <field name="percentage" widget="percentage"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <button name="action_open_entries" type="object"
                                            string="Entries" icon="fa-search"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_crossovered_budget_search" model="ir.ui.view">
        <field name="name">crossovered.budget.search</field>
        <field name="model">crossovered.budget</field>
        <field name="arch" type="xml">
            <search string="Budgets">
                <field name="name"/>
                <field name="code"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="validated" string="Validated" domain="[('state', '=', 'validate')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_user" string="Responsible"
                            context="{'group_by': 'creating_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_crossovered_budget" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">crossovered.budget</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_crossovered_budget_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Plan your first budget</p>
            <p>
                Each line crosses a budgetary position with an analytic account over
                a date range, and compares what you planned against what the ledger
                actually shows.
            </p>
        </field>
    </record>

    <!-- Cross-budget analysis -->
    <record id="view_crossovered_budget_lines_list" model="ir.ui.view">
        <field name="name">crossovered.budget.lines.list</field>
        <field name="model">crossovered.budget.lines</field>
        <field name="arch" type="xml">
            <list string="Budget Lines" create="false"
                  decoration-danger="percentage &gt; 1.0">
                <field name="crossovered_budget_id"/>
                <field name="general_budget_id"/>
                <field name="analytic_account_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="planned_amount" sum="Planned"/>
                <field name="practical_amount" sum="Practical"/>
                <field name="theoritical_amount" sum="Theoretical"/>
                <field name="percentage" widget="percentage"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_crossovered_budget_lines_search" model="ir.ui.view">
        <field name="name">crossovered.budget.lines.search</field>
        <field name="model">crossovered.budget.lines</field>
        <field name="arch" type="xml">
            <search string="Budget Lines">
                <field name="crossovered_budget_id"/>
                <field name="general_budget_id"/>
                <field name="analytic_account_id"/>
                <group>
                    <filter name="group_budget" string="Budget"
                            context="{'group_by': 'crossovered_budget_id'}"/>
                    <filter name="group_position" string="Budgetary Position"
                            context="{'group_by': 'general_budget_id'}"/>
                    <filter name="group_analytic" string="Analytic Account"
                            context="{'group_by': 'analytic_account_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_crossovered_budget_lines" model="ir.actions.act_window">
        <field name="name">Budget Analysis</field>
        <field name="res_model">crossovered.budget.lines</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_crossovered_budget_lines_search"/>
    </record>

</odoo>

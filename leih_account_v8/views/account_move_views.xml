<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Show the accounting period on journal entries and journal items. -->

    <record id="view_move_form_period" model="ir.ui.view">
        <field name="name">account.move.form.period</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="period_id"
                       domain="[('company_id', '=', company_id)]"
                       readonly="state != 'draft'"/>
            </field>
        </field>
    </record>

    <record id="view_move_line_list_period" model="ir.ui.view">
        <field name="name">account.move.line.list.period</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="period_id" optional="hide"/>
                <field name="tax_code_id" optional="hide"/>
                <field name="tax_amount" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>

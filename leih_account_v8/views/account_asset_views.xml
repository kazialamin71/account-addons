<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= Asset categories ================= -->
    <record id="view_account_asset_category_list" model="ir.ui.view">
        <field name="name">account.asset.category.list</field>
        <field name="model">account.asset.category</field>
        <field name="arch" type="xml">
            <list string="Asset Categories">
                <field name="name"/>
                <field name="method"/>
                <field name="method_number"/>
                <field name="method_period"/>
                <field name="journal_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_account_asset_category_form" model="ir.ui.view">
        <field name="name">account.asset.category.form</field>
        <field name="model">account.asset.category</field>
        <field name="arch" type="xml">
            <form string="Asset Category">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Medical Equipment"/></h1>
                    </div>
                    <group>
                        <group string="Accounts">
                            <field name="journal_id"/>
                            <field name="account_asset_id"/>
                            <field name="account_depreciation_id"/>
                            <field name="account_depreciation_expense_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Depreciation Method">
                            <field name="method"/>
                            <field name="method_progress_factor"
                                   invisible="method != 'degressive'"/>
                            <field name="method_time"/>
                            <field name="method_number"
                                   invisible="method_time != 'number'"/>
                            <field name="method_end"
                                   invisible="method_time != 'end'"
                                   required="method_time == 'end'"/>
                            <field name="method_period"/>
                            <field name="prorata"/>
                            <field name="open_asset"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_asset_category" model="ir.actions.act_window">
        <field name="name">Asset Categories</field>
        <field name="res_model">account.asset.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define an asset category</p>
            <p>
                A category holds the accounts and the depreciation policy. Assets
                created in it inherit that policy, so you set the rules once.
            </p>
        </field>
    </record>

    <!-- ================= Assets ================= -->
    <record id="view_account_asset_asset_list" model="ir.ui.view">
        <field name="name">account.asset.asset.list</field>
        <field name="model">account.asset.asset</field>
        <field name="arch" type="xml">
            <list string="Assets" decoration-info="state == 'draft'"
                  decoration-muted="state == 'close'">
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="category_id"/>
                <field name="date"/>
                <field name="value" sum="Gross"/>
                <field name="depreciated_value" sum="Depreciated"/>
                <field name="value_residual" sum="Residual"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'open'"
                       decoration-muted="state == 'close'"/>
            </list>
        </field>
    </record>

    <record id="view_account_asset_asset_form" model="ir.ui.view">
        <field name="name">account.asset.asset.form</field>
        <field name="model">account.asset.asset</field>
        <field name="arch" type="xml">
            <form string="Asset">
                <header>
                    <button name="compute_depreciation_board" type="object"
                            string="Compute Depreciation Board"
                            invisible="state == 'close'"/>
                    <button name="validate" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="set_to_close" type="object" string="Dispose"
                            invisible="state != 'open'"
                            confirm="Any instalment that has not been posted will be removed. Continue?"/>
                    <button name="set_to_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,close"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_entries" type="object"
                                class="oe_stat_button" icon="fa-book">
                            <field name="entry_count" widget="statinfo" string="Entries"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Ultrasound Machine"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category_id"/>
                            <field name="partner_id"/>
                            <field name="date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group>
                            <field name="value" readonly="state != 'draft'"/>
                            <field name="salvage_value" readonly="state != 'draft'"/>
                            <field name="depreciated_value"/>
                            <field name="value_residual"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Depreciation Board" name="board">
                            <field name="depreciation_line_ids" readonly="1">
                                <list decoration-muted="move_check">
                                    <field name="sequence" optional="hide"/>
                                    <field name="name"/>
                                    <field name="depreciation_date"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="depreciated_value"/>
                                    <field name="remaining_value"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="move_id" optional="show"/>
                                    <field name="move_check" widget="boolean_toggle"/>
                                    <button name="create_move" type="object"
                                            string="Post" icon="fa-check"
                                            invisible="move_check or parent_state != 'open'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Depreciation Method" name="method">
                            <group>
                                <group>
                                    <field name="method" readonly="state != 'draft'"/>
                                    <field name="method_progress_factor"
                                           invisible="method != 'degressive'"
                                           readonly="state != 'draft'"/>
                                    <field name="prorata" readonly="state != 'draft'"/>
                                </group>
                                <group>
                                    <field name="method_time" readonly="state != 'draft'"/>
                                    <field name="method_number"
                                           invisible="method_time != 'number'"
                                           readonly="state != 'draft'"/>
                                    <field name="method_end"
                                           invisible="method_time != 'end'"
                                           required="method_time == 'end'"
                                           readonly="state != 'draft'"/>
                                    <field name="method_period" readonly="state != 'draft'"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_account_asset_asset_search" model="ir.ui.view">
        <field name="name">account.asset.asset.search</field>
        <field name="model">account.asset.asset</field>
        <field name="arch" type="xml">
            <search string="Assets">
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="running" string="Running" domain="[('state', '=', 'open')]"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'close')]"/>
                <group>
                    <filter name="group_category" string="Category"
                            context="{'group_by': 'category_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Asset Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_account_asset_asset" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">account.asset.asset</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_account_asset_asset_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first asset</p>
            <p>
                Enter the asset and confirm it: the depreciation board is generated
                from the category's policy, and each instalment can be posted when
                its date arrives.
            </p>
        </field>
    </record>

    <record id="action_account_asset_depreciation_line" model="ir.actions.act_window">
        <field name="name">Depreciation Lines</field>
        <field name="res_model">account.asset.depreciation.line</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_account_asset_depreciation_line_list" model="ir.ui.view">
        <field name="name">account.asset.depreciation.line.list</field>
        <field name="model">account.asset.depreciation.line</field>
        <field name="arch" type="xml">
            <list string="Depreciation Lines" create="false"
                  decoration-muted="move_check">
                <field name="asset_id"/>
                <field name="name"/>
                <field name="depreciation_date"/>
                <field name="amount" sum="Total"/>
                <field name="remaining_value"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="move_id"/>
                <field name="move_check"/>
                <button name="create_move" type="object" string="Post"
                        icon="fa-check" invisible="move_check"/>
            </list>
        </field>
    </record>

    <record id="view_account_asset_depreciation_line_form" model="ir.ui.view">
        <field name="name">account.asset.depreciation.line.form</field>
        <field name="model">account.asset.depreciation.line</field>
        <field name="arch" type="xml">
            <form string="Depreciation Line">
                <sheet>
                    <group>
                        <group>
                            <field name="asset_id"/>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="depreciation_date"/>
                            <field name="amount"/>
                            <field name="depreciated_value"/>
                            <field name="remaining_value"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="move_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_voucher_list" model="ir.ui.view">
        <field name="name">account.voucher.list</field>
        <field name="model">account.voucher</field>
        <field name="arch" type="xml">
            <list string="Vouchers" decoration-info="state == 'draft'"
                  decoration-muted="state == 'cancel'">
                <field name="number"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="journal_id"/>
                <field name="reference" optional="show"/>
                <field name="name" string="Memo" optional="hide"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'posted'"
                       decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_account_voucher_form" model="ir.ui.view">
        <field name="name">account.voucher.form</field>
        <field name="model">account.voucher</field>
        <field name="arch" type="xml">
            <form string="Voucher">
                <header>
                    <button name="action_allocate_full" type="object"
                            string="Allocate Oldest First"
                            invisible="state != 'draft'"
                            help="Spread the paid amount over the open items, oldest first."/>
                    <button name="action_post" type="object" string="Validate"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'posted'"
                            confirm="This reverses the journal entry and breaks the reconciliations it made. Continue?"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_move" type="object"
                                class="oe_stat_button" icon="fa-book"
                                invisible="not move_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Journal</span>
                                <span class="o_stat_text">Entry</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="number" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="voucher_type" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="name" placeholder="e.g. Payment for INV/2026/0012"
                                   readonly="state != 'draft'"/>
                            <field name="reference" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="period_id" readonly="state != 'draft'"/>
                            <field name="journal_id" readonly="state != 'draft'"/>
                            <field name="account_id" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Allocations" name="allocations">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" create="false">
                                    <field name="name" readonly="1"/>
                                    <field name="date_original" readonly="1"/>
                                    <field name="date_due" readonly="1"/>
                                    <field name="account_id" readonly="1" optional="hide"/>
                                    <field name="amount_original" readonly="1"/>
                                    <field name="amount_unreconciled" readonly="1"/>
                                    <field name="amount" sum="Allocated"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="move_line_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="allocated"/>
                                <field name="difference"/>
                            </group>
                        </page>
                        <page string="Payment Difference" name="difference">
                            <group>
                                <field name="payment_option" readonly="state != 'draft'"/>
                                <field name="writeoff_acc_id"
                                       invisible="payment_option != 'with_writeoff'"
                                       required="payment_option == 'with_writeoff'"
                                       readonly="state != 'draft'"/>
                                <field name="comment"
                                       invisible="payment_option != 'with_writeoff'"
                                       readonly="state != 'draft'"/>
                            </group>
                            <p class="text-muted">
                                "Keep Open" leaves the unallocated part sitting on the partner
                                account as an advance. "Reconcile Payment Balance" books it to
                                the write-off account instead.
                            </p>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="narration" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_account_voucher_search" model="ir.ui.view">
        <field name="name">account.voucher.search</field>
        <field name="model">account.voucher</field>
        <field name="arch" type="xml">
            <search string="Vouchers">
                <field name="number"/>
                <field name="partner_id"/>
                <field name="reference"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <separator/>
                <filter name="receipts" string="Receipts" domain="[('voucher_type', '=', 'receipt')]"/>
                <filter name="payments" string="Payments" domain="[('voucher_type', '=', 'payment')]"/>
                <group>
                    <filter name="group_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_journal" string="Journal" context="{'group_by': 'journal_id'}"/>
                    <filter name="group_date" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_account_voucher_receipt" model="ir.actions.act_window">
        <field name="name">Customer Receipts</field>
        <field name="res_model">account.voucher</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('voucher_type', '=', 'receipt')]</field>
        <field name="context">{'default_voucher_type': 'receipt'}</field>
        <field name="search_view_id" ref="view_account_voucher_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record a customer receipt</p>
            <p>
                Pick the customer to load their open invoices, enter the amount
                received, allocate it, then validate. The journal entry and the
                reconciliations are created for you.
            </p>
        </field>
    </record>

    <record id="action_account_voucher_payment" model="ir.actions.act_window">
        <field name="name">Supplier Payments</field>
        <field name="res_model">account.voucher</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('voucher_type', '=', 'payment')]</field>
        <field name="context">{'default_voucher_type': 'payment'}</field>
        <field name="search_view_id" ref="view_account_voucher_search"/>
    </record>

</odoo>

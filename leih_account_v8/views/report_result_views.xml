<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- On-screen result grids. Group rows are bold; detail rows are indented
         through the level field so the hierarchy reads like the printed report. -->

    <record id="view_report_ledger_line_list" model="ir.ui.view">
        <field name="name">leih.report.ledger.line.list</field>
        <field name="model">leih.report.ledger.line</field>
        <field name="arch" type="xml">
            <list string="Ledger" create="false" delete="false" edit="false"
                  default_order="sequence" decoration-bf="is_group"
                  decoration-info="is_group">
                <field name="sequence" column_invisible="True"/>
                <field name="is_group" column_invisible="True"/>
                <field name="date"/>
                <field name="account_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="journal_id" optional="hide"/>
                <field name="move_id" optional="show"/>
                <field name="ref" optional="hide"/>
                <field name="label" string="Description"/>
                <field name="date_maturity" optional="hide"/>
                <field name="reconciled" string="Matching" optional="hide"/>
                <field name="debit" sum="Debit"/>
                <field name="credit" sum="Credit"/>
                <field name="cumulative" string="Balance"/>
                <field name="currency_id" column_invisible="True"/>
                <button name="action_open_entry" type="object" string="Open"
                        icon="fa-external-link" invisible="not move_id"/>
            </list>
        </field>
    </record>

    <record id="view_report_balance_line_list" model="ir.ui.view">
        <field name="name">leih.report.balance.line.list</field>
        <field name="model">leih.report.balance.line</field>
        <field name="arch" type="xml">
            <list string="Trial Balance" create="false" delete="false" edit="false"
                  default_order="sequence">
                <field name="sequence" column_invisible="True"/>
                <field name="code"/>
                <field name="name"/>
                <field name="initial_balance" sum="Initial"/>
                <field name="debit" sum="Debit"/>
                <field name="credit" sum="Credit"/>
                <field name="balance" sum="Balance"/>
                <field name="currency_id" column_invisible="True"/>
                <button name="action_open_items" type="object" string="Journal Items"
                        icon="fa-search" invisible="not account_id"/>
                <field name="account_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_report_financial_line_list" model="ir.ui.view">
        <field name="name">leih.report.balance.line.financial.list</field>
        <field name="model">leih.report.balance.line</field>
        <field name="arch" type="xml">
            <list string="Financial Report" create="false" delete="false" edit="false"
                  default_order="sequence" decoration-bf="is_group">
                <field name="sequence" column_invisible="True"/>
                <field name="is_group" column_invisible="True"/>
                <field name="level" string="Lvl" optional="hide"/>
                <field name="code" optional="hide"/>
                <field name="name" string="Item"/>
                <field name="debit" optional="hide" sum="Debit"/>
                <field name="credit" optional="hide" sum="Credit"/>
                <field name="balance" string="Amount"/>
                <field name="balance_cmp" string="Comparison" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <button name="action_open_items" type="object" string="Journal Items"
                        icon="fa-search" invisible="not account_id"/>
                <field name="account_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_report_aged_line_list" model="ir.ui.view">
        <field name="name">leih.report.aged.line.list</field>
        <field name="model">leih.report.aged.line</field>
        <field name="arch" type="xml">
            <list string="Aged Partner Balance" create="false" delete="false" edit="false"
                  default_order="sequence">
                <field name="sequence" column_invisible="True"/>
                <field name="partner_id"/>
                <field name="not_due" sum="Not Due"/>
                <field name="period0" sum="Bucket 1"/>
                <field name="period1" sum="Bucket 2"/>
                <field name="period2" sum="Bucket 3"/>
                <field name="period3" sum="Bucket 4"/>
                <field name="period4" sum="Older"/>
                <field name="total" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_report_tax_line_list" model="ir.ui.view">
        <field name="name">leih.report.tax.line.list</field>
        <field name="model">leih.report.tax.line</field>
        <field name="arch" type="xml">
            <list string="Taxes Report" create="false" delete="false" edit="false"
                  default_order="sequence" decoration-bf="is_group">
                <field name="sequence" column_invisible="True"/>
                <field name="is_group" column_invisible="True"/>
                <field name="level" string="Lvl" optional="hide"/>
                <field name="code"/>
                <field name="name"/>
                <field name="amount" sum="Amount"/>
                <field name="currency_id" column_invisible="True"/>
                <button name="action_open_items" type="object" string="Journal Items"
                        icon="fa-search"/>
                <field name="tax_code_id" column_invisible="True"/>
            </list>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="account_reports.LegacyDropdown">
        <CoreDropdown
            position="props.position"
            menuClass="menuClasses"
            disabled="props.disabled"
            beforeOpen="props.beforeOpen"
        >
            <button type="button" t-att-class="togglerClasses">
                <t t-slot="toggler"/>
            </button>

            <t t-set-slot="content">
                <t t-slot="default"/>
            </t>
        </CoreDropdown>
    </t>
</templates>

